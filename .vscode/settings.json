{
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.formatOnSave": true,
  "files.eol": "\n",
  // --- Presentation Style Settings ---
  "editor.fontFamily": "Source Code Pro",
  "workbench.colorTheme": "Default High Contrast",
  "editor.fontSize": 14,
  "window.zoomLevel": 3,
  "editor.scrollbar.verticalScrollbarSize": 0,
  "editor.minimap.enabled": false,
  "editor.matchBrackets": "never",
  "workbench.statusBar.visible": false,
  // --- Presentation Style Settings ---
  // It looks nice to install extensions inside of our Dev Container instead of your global
  // Thus, by default we try to use workspace kind if it is supported and ui for the other extensions
  // Read more about extension kind:
  // - https://code.visualstudio.com/docs/devcontainers/containers#_advanced-forcing-an-extension-to-run-locally-or-remotely
  // - https://code.visualstudio.com/api/advanced-topics/extension-host#preferred-extension-location
  "remote.extensionKind": {
    // Since it is a Web Extension (https://code.visualstudio.com/api/extension-guides/web-extensions) ui kind is going to work in GitHub Codespaces as well
    "k--kato.intellij-idea-keybindings": [
      "ui"
    ],
    // We can install it to our Dev Container
    "ms-azuretools.vscode-containers": [
      "workspace"
    ],
    "github.vscode-github-actions": [
      "workspace"
    ],
    "ms-dotnettools.csdevkit": [
      "workspace"
    ],
    "csharpier.csharpier-vscode": [
      "workspace"
    ],
  },
  "[csharp]": {
    "editor.defaultFormatter": "csharpier.csharpier-vscode",
    "editor.formatOnSaveMode": "file",
  },
  "[xml]": {
    "editor.defaultFormatter": "csharpier.csharpier-vscode",
  },
}